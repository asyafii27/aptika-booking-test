{
    "info": {
        "name": "Aptika Booking",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api/v1"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "room_id",
            "value": ""
        },
        {
            "key": "booking_id",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login Admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.collectionVariables.set('token', pm.response.json().token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@test.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": "{{base_url}}/auth/login"
                    }
                },
                {
                    "name": "Login User Satu",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.collectionVariables.set('token', pm.response.json().token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user1@test.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": "{{base_url}}/auth/login"
                    }
                },
                {
                    "name": "Login User Dua",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.collectionVariables.set('token', pm.response.json().token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user2@test.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": "{{base_url}}/auth/login"
                    }
                },
                {
                    "name": "Logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.collectionVariables.set('token', '');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/auth/logout"
                    }
                }
            ]
        },
        {
            "name": "Master Room",
            "item": [
                {
                    "name": "List Rooms",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rooms?search=&is_active=&sort_by=id&sort_dir=asc&page=1&page_size=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rooms"
                            ],
                            "query": [
                                {
                                    "key": "search",
                                    "value": ""
                                },
                                {
                                    "key": "is_active",
                                    "value": ""
                                },
                                {
                                    "key": "sort_by",
                                    "value": "id"
                                },
                                {
                                    "key": "sort_dir",
                                    "value": "asc"
                                },
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "page_size",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Check Room Availability",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rooms/available?start_time=2030-01-15 09:00:00&end_time=2030-01-15 10:00:00&capacity=&search=&sort_by=name&sort_dir=asc",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rooms",
                                "available"
                            ],
                            "query": [
                                {
                                    "key": "start_time",
                                    "value": "2030-01-15 09:00:00"
                                },
                                {
                                    "key": "end_time",
                                    "value": "2030-01-15 10:00:00"
                                },
                                {
                                    "key": "capacity",
                                    "value": ""
                                },
                                {
                                    "key": "search",
                                    "value": ""
                                },
                                {
                                    "key": "sort_by",
                                    "value": "name"
                                },
                                {
                                    "key": "sort_dir",
                                    "value": "asc"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Room",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                    "pm.collectionVariables.set('room_id', pm.response.json().id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Ruang Garuda\",\n    \"capacity\": 10\n}"
                        },
                        "url": "{{base_url}}/rooms"
                    }
                },
                {
                    "name": "Update Room",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Ruang Garuda Lantai 2\",\n    \"capacity\": 15\n}"
                        },
                        "url": "{{base_url}}/rooms/{{room_id}}"
                    }
                }
            ]
        },
        {
            "name": "Transaction Booking",
            "item": [
                {
                    "name": "List Bookings",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/bookings?search=&room_id=&user_id=&status=&start_date=&end_date=&sort_by=start_time&sort_dir=asc&page=1&page_size=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings"
                            ],
                            "query": [
                                {
                                    "key": "search",
                                    "value": ""
                                },
                                {
                                    "key": "room_id",
                                    "value": ""
                                },
                                {
                                    "key": "user_id",
                                    "value": ""
                                },
                                {
                                    "key": "status",
                                    "value": ""
                                },
                                {
                                    "key": "start_date",
                                    "value": ""
                                },
                                {
                                    "key": "end_date",
                                    "value": ""
                                },
                                {
                                    "key": "sort_by",
                                    "value": "start_time"
                                },
                                {
                                    "key": "sort_dir",
                                    "value": "asc"
                                },
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "page_size",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Booking",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                                    "pm.collectionVariables.set(\"booking_id\", pm.response.json().id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"room_id\": \"{{room_id}}\",\n    \"title\": \"Rapat Tim\",\n    \"start_time\": \"2030-01-15 09:00:00\",\n    \"end_time\": \"2030-01-15 10:00:00\"\n}"
                        },
                        "url": "{{base_url}}/bookings"
                    }
                },
                {
                    "name": "Cancel Booking",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/bookings/{{booking_id}}/cancel"
                    }
                }
            ]
        }
    ]
}
